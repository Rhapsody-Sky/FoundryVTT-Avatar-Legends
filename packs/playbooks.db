{"name":"Rogue GQ","type":"growth-question","img":"systems/legends/images/tokens/growth-question.png","system":{"description":"Did you get a friend to join in or approve of one of your bad habits?"},"effects":[],"flags":{"core":{"sourceId":"Item.5RJLLB6bCO62bMb5"},"cf":{"id":"temp_sahiwcgpd49"}},"_stats":{"systemId":"legends","systemVersion":"0.3.15","coreVersion":"10.290","createdTime":1668895524960,"modifiedTime":1668895562374,"lastModifiedBy":"J2YTNkdactPZw8ww"},"folder":null,"sort":0,"ownership":{"default":0,"J2YTNkdactPZw8ww":3},"_id":"oPnKMMveNAcGQYHW"}
{"name":"Tag Team","type":"technique","img":"systems/legends/images/tokens/technique.png","system":{"description":"<p>Work with an ally against the same foe; choose an engaged foe and an ally&mdash;double any fatigue, conditions, or balance shifts that ally inflicts upon that foe.</p>","approach":"defend-maneuver","basic":false,"learned":false,"practiced":false,"mastered":false,"training":"","specialty":""},"effects":[],"flags":{"core":{"sourceId":"Item.vIpKrhl4chCm3SYR"},"cf":{"id":"temp_ggltm2gzi0h"}},"_stats":{"systemId":"legends","systemVersion":"0.3.15","coreVersion":"10.290","createdTime":1668877361313,"modifiedTime":1668880477046,"lastModifiedBy":"J2YTNkdactPZw8ww"},"folder":null,"sort":0,"ownership":{"default":0,"J2YTNkdactPZw8ww":3},"_id":"ogUecGRlrXGxAFgS"}
