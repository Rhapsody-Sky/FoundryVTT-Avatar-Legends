{"name":"Push Your Luck","type":"move","img":"systems/legends/images/tokens/move.png","system":{"description":"<p>When you <strong>push your luck</strong> in a risky situation, say what you want to do and roll with <span class=\"skill-name\">Passion</span>. On a hit, you do it, but it costs you to scrape by; the GM tells you what it costs you. On a 10+, your boldness pays off despite the cost; the GM tells you what other lucky opportunity falls in your lap.</p>","rollable":true,"rollStat":"passion","category":"basic"},"effects":[],"flags":{"core":{"sourceId":"Item.lEMdTg3g9kwwPiGd"},"cf":{"id":"temp_ys3wc4d1ofd"}},"_stats":{"systemId":"legends","systemVersion":"0.3.15","coreVersion":"10.290","createdTime":1668896248609,"modifiedTime":1668897013228,"lastModifiedBy":"J2YTNkdactPZw8ww"},"folder":null,"sort":0,"ownership":{"default":0,"J2YTNkdactPZw8ww":3},"_id":"h3ttpfOq1i5dnmVK"}
