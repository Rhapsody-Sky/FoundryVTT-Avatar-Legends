{"name":"Seize a Position","type":"technique","img":"systems/legends/images/tokens/technique.png","system":{"description":"<p>Move to a new location. Engage/disengage with a foe, overcome a negative status or danger, establish an advantageous position, or escape the scene. Any foe engaged with you can mark 1-fatigue to block this technique.</p>","approach":"defend-maneuver","basic":true,"learned":false,"practiced":false,"mastered":false,"training":"","specialty":""},"effects":[],"flags":{"core":{"sourceId":"Item.wkIW3rF2K9U6PHD4"},"cf":{"id":"temp_363u3kydac3"}},"_stats":{"systemId":"legends","systemVersion":"0.3.15","coreVersion":"10.290","createdTime":1668896756960,"modifiedTime":1668897339663,"lastModifiedBy":"J2YTNkdactPZw8ww"},"folder":null,"sort":0,"ownership":{"default":0,"J2YTNkdactPZw8ww":3},"_id":"kk5BBw5zaIpntlJG"}
{"name":"Inspired","type":"status","img":"systems/legends/images/tokens/condition.png","system":{"description":"<p>You&rsquo;re ready to stand for something&mdash;clear <em>Inspired</em> to shift your balance toward a principle of your choice.</p>","checked":false,"type":"positive"},"effects":[],"flags":{"core":{"sourceId":"Item.FrkDNmfOfbMBvvNM"},"cf":{"id":"temp_woc217r366i"}},"_stats":{"systemId":"legends","systemVersion":"0.3.15","coreVersion":"10.290","createdTime":1668898060385,"modifiedTime":1668898107832,"lastModifiedBy":"J2YTNkdactPZw8ww"},"folder":null,"sort":0,"ownership":{"default":0,"J2YTNkdactPZw8ww":3},"_id":"lj9MLtrEXMJgf2Bx"}
