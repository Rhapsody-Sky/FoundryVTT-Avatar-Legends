<div class="justify-content-end flexrow gap-25 npc-principle">
    <a
      data-action="setPrinciple"
      data-value="0"
      data-item-id="{{id}}"
      class="check-box {{#if (eq system.track.value 0)}} filled{{/if}}">
      <span class="num">
        +0
      </span>
    </a>
  {{#times system.track.max}}
    <a
      data-action="setPrinciple"
      data-value="{{@index}}"
      data-item-id="{{../id}}"
      class="check-box {{#if (eq ../system.track.value @index)}} filled{{/if}}">
      <span class="num">
        +{{@index}}
      </span>
    </a>
  {{/times}}
</div>