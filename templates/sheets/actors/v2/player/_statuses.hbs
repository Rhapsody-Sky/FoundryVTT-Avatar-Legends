<div>
  <h3 class='text-center border-bottom border-accent pb-25'>
    {{localize 'legends.actor-sheet.statuses'}}
  </h3>

  <div class='flexcol gap-50'>
    <div class='flexrow gap-100 align-items-start item-list'>
      {{#each statuses.positive as |status|}}
        {{> (template "sheets/actors/v2/player/_status.hbs") status}}
      {{/each}}
    </div>
    <div class='flexrow gap-100 align-items-start item-list'>
      {{#each statuses.negative as |status|}}
        {{> (template "sheets/actors/v2/player/_status.hbs") status}}
      {{/each}}
    </div>
  </div>
</div>