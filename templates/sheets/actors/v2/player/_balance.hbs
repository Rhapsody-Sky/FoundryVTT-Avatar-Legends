<div class='balance flexcol flex2 gap-25'>
  <h3 class="text-center border-bottom border-accent pb-25">{{ localize "legends.actor-sheet.balance" }}</h3>
  <div class='balance-black flexrow align-items-center size-150 gap-50'>
    <a class='icon fas fa-dice flex0' data-action='rollPrinciple' data-principle='topTrack'></a>
    <input class="font-brush size-150" type='text' name="system.balance.topTrack" value="{{system.balance.topTrack}}" placeholder="{{localize "legends.principle.title"}}" />
  </div>
  <div>
    <ul class="balance-track black">
      <li class="{{#if (eq system.balance.value 3)}} selected{{/if}}" data-action="setBalance" data-new-value="3"><a
          class="num">+3</a></li>
      <li class="{{#if (eq system.balance.value 2)}} selected{{/if}}" data-action="setBalance" data-new-value="2"><a
          class="num">+2</a></li>
      <li class="{{#if (eq system.balance.value 1)}} selected{{/if}}" data-action="setBalance" data-new-value="1"><a
          class="num">+1</a></li>
      <li class="{{#if (eq system.balance.value 0)}} selected{{/if}}" data-action="setBalance" data-new-value="0"><a
          class="num">0</a></li>
      <li class="{{#if (eq system.balance.value -1)}} selected{{/if}}" data-action="setBalance" data-new-value="-1"><a
          class="num">-1</a></li>
      <li class="{{#if (eq system.balance.value -2)}} selected{{/if}}" data-action="setBalance" data-new-value="-2"><a
          class="num">-2</a></li>
      <li class="{{#if (eq system.balance.value -3)}} selected{{/if}}" data-action="setBalance" data-new-value="-3"><a
          class="num">-3</a></li>
    </ul>
  </div>
  <div>
    <ul class="balance-center-track">
      <li><a data-action="setCenter" data-new-value="3"
          class="check-box balance-box{{#if (eq system.balance.center 3)}} filled{{/if}}"></a></li>
      <li class="text">C</li>
      <li><a data-action="setCenter" data-new-value="2"
          class="check-box balance-box{{#if (eq system.balance.center 2)}} filled{{/if}}"></a></li>
      <li class="text">E</li>
      <li><a data-action="setCenter" data-new-value="1"
          class="check-box balance-box{{#if (eq system.balance.center 1)}} filled{{/if}}"></a></li>
      <li class="text">N</li>
      <li><a data-action="setCenter" data-new-value="0"
          class="check-box balance-box{{#if (eq system.balance.center 0)}} filled{{/if}}"></a></li>
      <li class="text">T</li>
      <li><a data-action="setCenter" data-new-value="-1"
          class="check-box balance-box{{#if (eq system.balance.center -1)}} filled{{/if}}"></a></li>
      <li class="text">E</li>
      <li><a data-action="setCenter" data-new-value="-2"
          class="check-box balance-box{{#if (eq system.balance.center -2)}} filled{{/if}}"></a></li>
      <li class="text">R</li>
      <li><a data-action="setCenter" data-new-value="-3"
          class="check-box balance-box{{#if (eq system.balance.center -3)}} filled{{/if}}"></a></li>
    </ul>
  </div>

  <div>
    <ul class="balance-track white">
      <li class="set-balance{{#if (eq system.balance.value 3)}} selected{{/if}}" data-action="setBalance" data-new-value="3"><a
          class="num">-3</a></li>
      <li class="set-balance{{#if (eq system.balance.value 2)}} selected{{/if}}" data-action="setBalance" data-new-value="2"><a
          class="num">-2</a></li>
      <li class="set-balance{{#if (eq system.balance.value 1)}} selected{{/if}}" data-action="setBalance" data-new-value="1"><a
          class="num">-1</a></li>
      <li class="set-balance{{#if (eq system.balance.value 0)}} selected{{/if}}" data-action="setBalance" data-new-value="0"><a
          class="num">0</a></li>
      <li class="set-balance{{#if (eq system.balance.value -1)}} selected{{/if}}" data-action="setBalance" data-new-value="-1"><a
          class="num">+1</a></li>
      <li class="set-balance{{#if (eq system.balance.value -2)}} selected{{/if}}" data-action="setBalance" data-new-value="-2"><a
          class="num">+2</a></li>
      <li class="set-balance{{#if (eq system.balance.value -3)}} selected{{/if}}" data-action="setBalance" data-new-value="-3"><a
          class="num">+3</a></li>
    </ul>
  </div>
  <div class='balance-white flexrow align-items-center size-150 gap-50'>
    <input class="font-brush size-150" type='text' name="system.balance.bottomTrack" value="{{system.balance.bottomTrack}}" placeholder="{{localize "legends.principle.title"}}" />
    <a class='icon fas fa-dice flex0' data-action='rollPrinciple' data-principle='bottomTrack'></a>
  </div>
</div>