<div id='combatant-{{combatant.id}}'
     data-combatant-id="{{combatant.id}}"
     class='height-350 flexrow gap-50 align-items-center combatant combatant-full {{#if combatant.hidden}}legends-hidden{{/if}}'>

    <div class="flex0-3rem token">
      {{#if combatant.hidden}}
        <div class="overlay" data-tooltip="Hidden">
          <i class="fas fa-eye-slash"></i>
        </div>
      {{/if}}
      {{#if combatant.defeated}}
        <div class="overlay" data-tooltip="Hidden">
          <i class="fas fa-skull"></i>
        </div>
      {{/if}}
      <img src='{{combatant.img}}' alt='{{combatant.name}}' />
    </div>
    <div class="flexcol gap-50">
      <div class='flexrow gap-50 align-items-start'>
        <h4 class='m-0 size-100 flex3 ellipsis line-height-120 color-white weight-normal'>{{combatant.name}}</h4>
        {{#if (any combatant.effects)}}
          <div class='flexrow gap-25 justify-content-end flex-nowrap'>
            {{#each combatant.effects as |effect|}}
              <img class="token-effect" src="{{effect.img}}" data-tooltip="{{effect.name}}" />
            {{/each}}
          </div>
        {{/if}}
        <div class="flex0 nowrap text-right">
          {{combatant.resource}}
        </div>
      </div>

      <div class="flexrow gap-50 justify-space-between">
        <div class="flexrow gap-25 flex0 flex-nowrap">
          {{#if (and @root.round (eq @root.currentPhase 'choose') combatant.canView)}}
            {{#each @root.config.approaches as |name key|}}
              <a class="btn approach {{key}} {{#if (eq key ../combatant.currentPhase)}}active{{/if}}"
                data-action="setApproach"
                data-combatant-id="{{../combatant.id}}"
                data-approach="{{key}}"
                data-tooltip="{{localize name}}">
                {{localize (concat name '_short')}}
              </a>
            {{/each}}
          {{/if}}
        </div>
        <div class="flexrow gap-25 flex0 flex-nowrap">
          {{#if @root.user.isGM}}
            <div class='flex0 nowrap'>
              <a data-action='toggleHidden'
                class='combatant-action {{#if combatant.hidden}}active{{/if}}'
                data-tooltip="{{localize 'legends.exchange.toggle-hidden'}}">
                <i class='fas fa-eye-slash'></i>
              </a>
            </div>
            <div class='flex0 nowrap'>
              <a data-action='toggleDefeated'
                class='combatant-action {{#if combatant.defeated}}active{{/if}}'
                data-tooltip="{{localize 'legends.exchange.toggle-defeated'}}">
                <i class='fas fa-skull'></i>
              </a>
            </div>
          {{/if}}
          <div class='flex0 nowrap'>
            <a data-action='pingCombatant'
              class='combatant-action'
              data-tooltip='{{localize "legends.exchange.ping-combatant"}}'>
              <i class='fas fa-bullseye-arrow'></i>
            </a>
          </div>
        </div>
      </div>
    </div>
    {{#if (eq @root.currentPhase combatant.currentPhase)}}
      <div class="flex0-3rem text-center">
        {{#unless combatant.rollResult}}
            {{#if combatant.canRoll}}
            <a class="stance-move btn {{combatant.currentPhase}} p-25"
              data-action="rollStance"
              data-combatant-id="{{combatant.id}}">
              <i class="fas fa-dice"></i>
            </a>
          {{/if}}
        {{else}}
          {{#if combatant.isNpc}}
            <span class="npc-principle flexrow">
              <span class="check-box">
                <span class="num">
                  {{combatant.rollResult}}
                </span>
              </span>
            </span>
          {{else}}
            <span class="font-brush size-120 color-{{combatant.rollResult}} nowrap"
              data-tooltip="{{localize (concat 'legends.roll.approach.' combatant.rollResult)}}">
              {{localize (concat 'legends.roll.' combatant.rollResult)}}
            </span>
          {{/if}}
        {{/unless}}
      </div>
    {{/if}}
</div>